# Grafana 配置
grafana:
  url: "http://your-grafana-host:3000/"
  api_key: ""  # 或通过环境变量 GRAFANA_API_KEY 设置


# 数据源配置
datasources:
  # Prometheus 数据源
  - name: "Prom-API-Dev"
    type: "prometheus"
    access: "proxy"
    url: "https://prometheus.example.com/"

  # 阿里云 SLS 日志服务数据源 (Elasticsearch 格式)
  - name: "ES-API-Dev-(ext_request_log)"
    type: "elasticsearch"
    access: "proxy"
    url: "https://your-project.ap-southeast-1.log.aliyuncs.com/es/"
    index: "your-project.ext_request_log"
    basic_auth: true
    basic_auth_user: ""       # 填入阿里云 AccessKey ID
    basic_auth_password: ""   # 填入阿里云 AccessKey Secret
    es_version: "8.0.0"
    time_field: "@timestamp"

  # 阿里云 SLS 日志服务数据源 (原生格式)
  - name: "SLS-API-Dev"
    type: "aliyun-log-service-datasource"
    endpoint: "ap-southeast-1.log.aliyuncs.com"
    project: "your-sls-project-name"
    access_key_id: ""         # 填入阿里云 AccessKey ID
    access_key_secret: ""     # 填入阿里云 AccessKey Secret
