      "gridPos": {
        "h": 28,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 34,
      "options": {
        "cellHeight": "md",
        "enablePagination": true,
        "frameIndex": 0,
        "maxRowHeight": 20,
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "内存占用"
          }
        ]
      },
      "pluginVersion": "13.0.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "label_replace(\n  label_replace(\n    kube_statefulset_status_replicas{namespace=\"${namespace}\"} > 0,\n    \"game_id\", \"$1\", \"statefulset\", \"^(.*)-([a-b])$\"\n  ),\n  \"version\", \"$2\", \"statefulset\", \"^(.*)-([a-b])$\"\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (statefulset) (\n  rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\", namespace=\"${namespace}\"}[5m])\n  * on (namespace, pod) group_left(statefulset)\n  label_replace(\n    kube_pod_info{namespace=\"${namespace}\", created_by_kind=\"StatefulSet\"},\n    \"statefulset\", \"$1\", \"created_by_name\", \"(.*)\"\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (statefulset) (\n  container_memory_working_set_bytes{container!=\"\", container!=\"POD\", namespace=\"${namespace}\"}\n  * on (namespace, pod) group_left(statefulset)\n  label_replace(\n    kube_pod_info{namespace=\"${namespace}\", created_by_kind=\"StatefulSet\"},\n    \"statefulset\", \"$1\", \"created_by_name\", \"(.*)\"\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${cluster}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (statefulset) (\n  label_replace(\n    process_open_fds{namespace=\"${namespace}\"},\n    \"statefulset\", \"$1\", \"pod\", \"^(.*)-[0-9]+$\"\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "游戏资源使用统计",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "statefulset",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "config": {
                  "id": "isNotNull",
                  "options": {}
                },
                "fieldName": "Value #A"
              }
            ],
            "match": "any",
            "type": "include"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "cluster": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "statefulset": true
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "Value #A": "当前副本数",
              "Value #B": "CPU (核)",
              "Value #C": "内存占用",
              "Value #D": "文件描述符总数",
              "game_id": "游戏 ID",
              "instance": "",
              "service": "",
              "version": "活跃版本"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
